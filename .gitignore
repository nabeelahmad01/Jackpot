# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# db backups (contain user data)
/backups

# generated secret helper (Firebase service account)
/firebase-b64-correct.txt

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# temporary swap file used by portal:sync scripts
.capacitor.player.config.bak.ts

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.agent